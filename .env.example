# Required — your model API key (never commit the real key)
AI_API_KEY=sk-your-api-key-here

# Required — password for the "My Space" button on the portfolio
CONTENT_PASSWORD=Nanda@007

# Required for notes to save permanently — from your Upstash Redis database
# (Vercel → Storage → Upstash Redis adds these automatically on Vercel)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Optional — defaults shown below
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Examples for other providers:
# OpenRouter:  AI_API_BASE_URL=https://openrouter.ai/api/v1
# Groq:        AI_API_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=llama-3.3-70b-versatile
# Google AI:   AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
